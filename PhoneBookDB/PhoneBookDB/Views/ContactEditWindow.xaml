<Window x:Class="PhoneBookDB.Views.ContactEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" 
        Height="250" 
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <Label Content="Имя:" FontWeight="Bold"/>
            <TextBox Margin="0,5,0,0" 
                     Text="{Binding NameInput, UpdateSourceTrigger=PropertyChanged}"
                     Height="25"/>
        </StackPanel>

        <!-- Телефон -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <Label Content="Телефон:" FontWeight="Bold"/>
            <TextBox Margin="0,5,0,0" 
                     Text="{Binding PhoneInput, UpdateSourceTrigger=PropertyChanged}"
                     Height="25"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,15,0,0">
            <Button Content="Сохранить" 
                    Width="100" 
                    Height="30"
                    Margin="0,0,10,0"
                    Command="{Binding SaveCommand}"
                    IsDefault="True"/>
            <Button Content="Отмена" 
                    Width="100" 
                    Height="30"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>