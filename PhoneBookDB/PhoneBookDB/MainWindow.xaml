<Window x:Class="PhoneBookDB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Телефонная книга" Height="450" Width="650">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Кнопки -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Добавить" Width="110" Margin="0,0,5,0"
                    Command="{Binding AddCommand}"/>
            <Button Content="✏Изменить" Width="110" Margin="0,0,5,0"
                    Command="{Binding EditCommand}"/>
            <Button Content="Удалить" Width="110" Margin="0,0,5,0"
                    Command="{Binding DeleteCommand}"/>
            <Button Content="Обновить" Width="110" Margin="0,0,5,0"
                    Command="{Binding RefreshCommand}"/>
            <Button Content="Форматировать все" Width="160"
                    Command="{Binding NormalizeAllCommand}"/>
        </StackPanel>

        <!-- Список контактов -->
        <DataGrid Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  ItemsSource="{Binding Contacts}"
                  SelectedItem="{Binding SelectedContact}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>